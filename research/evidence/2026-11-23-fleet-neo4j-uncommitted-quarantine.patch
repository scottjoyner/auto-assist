+                "MATCH (e:ServiceEndpoint) RETURN e ORDER BY e.endpoint_id LIMIT $limit",
+                {"limit": max(1, min(int(limit), 2000))},
+            )
+            return [dict(r["e"]) for r in rows]
+
+    def list_model_endpoints(self, *, limit: int = 500) -> list[dict[str, Any]]:
