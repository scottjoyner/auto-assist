# Strict-offline AssistX + auto-router reconciliation environment.
# Copy to a private file outside the repository, chmod 600, and replace every
# change-me value. The generator in scripts/generate-reconciliation-secrets.py
# creates the key paths and independent random service tokens automatically.

# ---- Existing AssistX authority ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_DATABASE=assistx
REDIS_URL=redis://redis:6379/0
BASIC_AUTH_USER=reconciliation-admin
BASIC_AUTH_PASS=change-me-assistx-api
WS_AUTH_REQUIRED=1
WS_AUTH_TOKEN=change-me-websocket
CORS_ALLOW_ORIGINS=http://127.0.0.1:18000

# ---- Isolated reconciliation topology ----
RECONCILIATION_ASSISTX_NETWORK=assistx_reconciliation_shared
ASSISTX_API_PORT=18000
ASSISTX_NEO4J_HTTP_PORT=17474
ASSISTX_NEO4J_BOLT_PORT=17687
RECONCILIATION_ROUTER_PORT=18088
ASSISTX_OVERLAY_MODE=router
ASSISTX_STRICT_OFFLINE=true
ASSISTX_TOOL_EGRESS_MODE=disabled

# ---- Runtime projection authority: distinct Ed25519 keypair ----
ASSISTX_RUNTIME_PROJECTION_PRIVATE_KEY_FILE=/absolute/private/path/runtime-projection-private.pem
ASSISTX_RUNTIME_PROJECTION_PUBLIC_KEY_FILE=/absolute/private/path/runtime-projection-public.pem
ASSISTX_RUNTIME_PROJECTION_KEY_ID=assistx-runtime-projection-v1
ASSISTX_RUNTIME_PROJECTION_TTL_SECONDS=60

# ---- Executor task capability: separate Ed25519 keypair ----
ASSISTX_EXECUTOR_PRIVATE_KEY_FILE=/absolute/private/path/executor-private.pem
ASSISTX_EXECUTOR_PUBLIC_KEY_FILE=/absolute/private/path/executor-public.pem
ASSISTX_EXECUTOR_KEY_ID=assistx-executor-v1
ASSISTX_EXECUTOR_BOOTSTRAP_TOKEN=change-me-executor-bootstrap
ASSISTX_EXECUTOR_SERVICE_TOKEN=change-me-router-claim-status

# ---- Router-only credentials: never reuse an admin or executor credential ----
AUTO_ROUTER_ADMIN_TOKEN=change-me-router-admin
AUTO_ROUTER_INTERNAL_SERVICE_TOKEN=change-me-assistx-internal-inference
AUTO_ROUTER_ASSISTX_BASIC_AUTH_USER=reconciliation-admin
AUTO_ROUTER_ASSISTX_BASIC_AUTH_PASS=change-me-assistx-api

# ---- Hermes remains disabled until the synthetic lifecycle passes ----
HERMES_SELFTASK_ENABLED=false
HERMES_MAX_TASKS_PER_LOOP=1
HERMES_HEARTBEAT_MAX_FAILURES=3
HERMES_LEASE_SECONDS=900
RECONCILIATION_EXECUTOR_UID=1000
RECONCILIATION_EXECUTOR_GID=1000
RECONCILIATION_HERMES_HOME=./artifacts/reconciliation-hermes-home

# ---- Runtime identity must be replaced with observed evidence ----
RECONCILIATION_RUNTIME_NODE_ID=x1-370
RECONCILIATION_RUNTIME_INSTANCE_ID=lmstudio-x1-370-1234
RECONCILIATION_RUNTIME_KIND=lmstudio
RECONCILIATION_RUNTIME_VERSION=change-me-from-runtime
RECONCILIATION_RUNTIME_HEADLESS=false
RECONCILIATION_PARALLEL_SLOTS=1
RECONCILIATION_QUEUE_LIMIT=4
RECONCILIATION_QUEUE_TIMEOUT_SECONDS=30
RECONCILIATION_LAN_BASE_URL=http://192.168.1.50:1234/v1
RECONCILIATION_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
RECONCILIATION_TAILSCALE_BASE_URL=http://100.64.43.123:1234/v1
RECONCILIATION_MODEL_ID=refinedtoolcallv5-3b
RECONCILIATION_MODEL_INSTANCE_ID=change-me-from-runtime
RECONCILIATION_MODEL_ARTIFACT_FINGERPRINT=change-me-sha256
RECONCILIATION_MODEL_QUANTIZATION=change-me
RECONCILIATION_CONTEXT_WINDOW=32768

# ---- Mutation/external-provider surfaces remain disabled ----
AUTO_ASSIGN_BASE_URL=
PAPERCLIP_API_URL=
PAPERCLIP_API_TOKEN=
ASSISTX_REPO_TASK_GENERATOR_ENABLED=false
ASSISTX_REPO_TASK_AUTO_READY=false
ASSISTX_RECOVERY_EXECUTION_ENABLED=false
FLEET_UNSAFE_SHELL_TASKS_ENABLED=false
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
