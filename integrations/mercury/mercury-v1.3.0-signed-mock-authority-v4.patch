diff --git a/src/bots/fleet-mock-coordinator.ts b/src/bots/fleet-mock-coordinator.ts
new file mode 100644
index 0000000..11c5021
--- /dev/null
+++ b/src/bots/fleet-mock-coordinator.ts
@@ -0,0 +1,179 @@
+/**
+ * OFFLINE TEST FIXTURE ONLY.
+ *
+ * Signed messages between simulated fleet nodes and ONE memory-backed
+ * coordinator. No port, persistence, real keys, HTTP, or vendor quotas.
+ * A separate server instance is a separate unsafe authority; never use this
+ * module to authorize real Mercury services.
+ */
+import { createHmac, randomUUID, timingSafeEqual } from 'node:crypto';
+import type { FleetLease, FleetLeaseAuthority, FleetLeaseRequest } from './fleet-provider-admission.js';
+
+export type MockOperation = 'acquire' | 'renew' | 'release';
+export interface MockPolicy {
+  nodeId: string;
+  botId: string;
+  provider: string;
+  model: string;
+  upstreamGroup: string;
+  maxInputTokens: number;
+  maxOutputTokens: number;
+}
+interface RequestMessage {
+  nodeId: string;
+  nonce: string;
+  operation: MockOperation;
+  request: FleetLeaseRequest;
+  lease: FleetLease | null;
+}
+interface SignedRequest { payload: RequestMessage; mac: string; }
+interface ResponseMessage {
+  nonce: string;
+  operation: MockOperation;
+  result: FleetLease | boolean | null;
+}
+interface SignedResponse { payload: ResponseMessage; mac: string; }
+
+function sign(key: Buffer, payload: unknown): string {
+  return createHmac('sha256', key).update(JSON.stringify(payload)).digest('hex');
+}
+
+function verified(key: Buffer, payload: unknown, mac: string): boolean {
+  if (typeof mac !== 'string' || !/^[a-f0-9]{64}$/.test(mac)) return false;
+  return timingSafeEqual(Buffer.from(mac, 'hex'), Buffer.from(sign(key, payload), 'hex'));
+}
+
+function requestIdentityMatches(a: FleetLeaseRequest, b: FleetLease): boolean {
+  return a.taskId === b.taskId && a.botId === b.botId
+    && a.provider === b.provider && a.model === b.model
+    && a.upstreamGroup === b.upstreamGroup;
+}
+
+/** Single-authority, process-local fixture with HMAC request/response custody. */
+export class MockSignedFleetCoordinator {
+  private keys: Map<string, Buffer>;
+  private readonly policies: readonly MockPolicy[];
+  private readonly seen = new Set<string>();
+  private readonly holders = new Map<string, { nodeId: string; lease: FleetLease }>();
+  private readonly ttlMs: number;
+  private readonly now: () => number;
+  private available = true;
+
+  constructor(opts: {
+    keys: Record<string, Buffer>;
+    policies: MockPolicy[];
+    ttlMs?: number;
+    now?: () => number;
+  }) {
+    this.keys = new Map(Object.entries(opts.keys).map(([id, key]) => [id, Buffer.from(key)]));
+    this.policies = opts.policies.map(p => ({ ...p }));
+    this.ttlMs = opts.ttlMs ?? 12_000;
+    this.now = opts.now ?? Date.now;
+    if (!Number.isInteger(this.ttlMs) || this.ttlMs < 100 || this.ttlMs > 120_000) {
+      throw Error('invalid_mock_ttl');
+    }
+    for (const [id, key] of this.keys) {
+      if (!/^[A-Za-z0-9_-]{3,128}$/.test(id) || key.length < 32) {
+        throw Error('invalid_mock_node_identity_or_key');
+      }
+    }
+  }
+
+  /** Partition / outage injection; transport throws, no permissive fallback. */
+  setAvailable(available: boolean): void { this.available = available; }
+
+  /** Operator-style revocation in the fixture (not remotely durable). */
+  revokeUpstream(group: string): void { this.holders.delete(group); }
+
+  /** Strictly test-only: shows how many slots are occupied. */
+  occupiedSlots(): number { return this.holders.size; }
+
+  handle(signed: SignedRequest): SignedResponse {
+    if (!this.available) throw Error('mock_coordinator_partition');
+    const payload = signed?.payload;
+    const nodeId = payload?.nodeId;
+    const key = this.keys.get(nodeId);
+    if (!key || !verified(key, payload, signed.mac)) {
+      throw Error('mock_authentication_failed');
+    }
+    if (!/^[0-9a-f-]{36}$/i.test(payload.nonce)) {
+      throw Error('mock_invalid_nonce');
+    }
+    const replayKey = nodeId + ':' + payload.nonce;
+    if (this.seen.has(replayKey)) throw Error('mock_replayed_message');
+    this.seen.add(replayKey);
+    const r = payload.request;
+    let result: FleetLease | boolean | null = null;
+    const allowed = this.policies.some(p =>
+      p.nodeId === nodeId && p.botId === r.botId && p.provider === r.provider
+      && p.model === r.model && p.upstreamGroup === r.upstreamGroup
+      && Number.isSafeInteger(r.maxInputTokens)
+      && Number.isSafeInteger(r.maxOutputTokens)
+      && r.maxInputTokens > 0 && r.maxOutputTokens > 0
+      && r.maxInputTokens <= p.maxInputTokens
+      && r.maxOutputTokens <= p.maxOutputTokens
+    );
+    const group = r.upstreamGroup;
+    const existing = this.holders.get(group);
+    if (existing && existing.lease.expiresAtMs <= this.now()) this.holders.delete(group);
+    const holder = this.holders.get(group);
+    if (allowed && payload.operation === 'acquire' && !payload.lease && !holder) {
+      const lease: FleetLease = { ...r, leaseId: randomUUID(), expiresAtMs: this.now() + this.ttlMs };
+      this.holders.set(group, { nodeId, lease });
+      result = { ...lease };
+    }
+    if (allowed && payload.operation === 'renew' && holder && payload.lease
+        && holder.nodeId === nodeId && holder.lease.leaseId === payload.lease.leaseId
+        && requestIdentityMatches(r, holder.lease)
+        && requestIdentityMatches(r, payload.lease)) {
+      const lease: FleetLease = { ...holder.lease, expiresAtMs: this.now() + this.ttlMs };
+      this.holders.set(group, { nodeId, lease });
+      result = { ...lease };
+    }
+    if (allowed && payload.operation === 'release' && holder && payload.lease
+        && holder.nodeId === nodeId && holder.lease.leaseId === payload.lease.leaseId
+        && requestIdentityMatches(r, holder.lease)
+        && requestIdentityMatches(r, payload.lease)) {
+      this.holders.delete(group);
+      result = true;
+    }
+    const response: ResponseMessage = { nonce: payload.nonce, operation: payload.operation, result };
+    return { payload: response, mac: sign(key, response) };
+  }
+}
+
+/** Authenticated fixture client. Only the server owns admission state. */
+export class MockSignedFleetClient implements FleetLeaseAuthority {
+  constructor(
+    private readonly nodeId: string,
+    private readonly key: Buffer,
+    private readonly transport: (message: SignedRequest) => SignedResponse,
+  ) {
+    if (key.length < 32) throw Error('invalid_mock_client_key');
+  }
+
+  private async call(
+    operation: MockOperation, request: FleetLeaseRequest, lease: FleetLease | null,
+  ): Promise<FleetLease | boolean | null> {
+    const payload: RequestMessage = {
+      nodeId: this.nodeId, nonce: randomUUID(), operation, request, lease,
+    };
+    const answer = await this.transport({ payload, mac: sign(this.key, payload) });
+    if (!answer || !verified(this.key, answer.payload, answer.mac)
+        || answer.payload.nonce !== payload.nonce
+        || answer.payload.operation !== operation) {
+      throw Error('mock_response_authentication_failed');
+    }
+    return answer.payload.result;
+  }
+
+  async acquire(request: FleetLeaseRequest): Promise<FleetLease | null> {
+    return await this.call('acquire', request, null) as FleetLease | null;
+  }
+  async renew(request: FleetLeaseRequest, lease: FleetLease): Promise<FleetLease | null> {
+    return await this.call('renew', request, lease) as FleetLease | null;
+  }
+  async release(request: FleetLeaseRequest, lease: FleetLease): Promise<boolean> {
+    return (await this.call('release', request, lease)) === true;
+  }
+}
diff --git a/src/bots/fleet-mock-manager.integration.test.ts b/src/bots/fleet-mock-manager.integration.test.ts
