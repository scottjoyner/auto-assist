index 0000000..fea4ca3
--- /dev/null
+++ b/src/bots/fleet-mock-manager.integration.test.ts
@@ -0,0 +1,113 @@
+/**
+ * Two isolated Mercury BotManager queues, one HMAC-signed mock coordinator.
+ * Tests the enqueue -> durable job -> runBotTurn -> real AI SDK mock call path.
+ * Never uses hosted models, shared prod queues or network provider transport.
+ */
+import { describe, expect, it, vi } from 'vitest';
+import { randomBytes } from 'node:crypto';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { MockLanguageModelV3 } from 'ai/test';
+import { BotManager } from './bot-manager.js';
+import { BotStore } from './store.js';
+import { getDefaultConfig } from '../utils/config.js';
+import { MockSignedFleetClient, MockSignedFleetCoordinator } from './fleet-mock-coordinator.js';
+
+function completedStream(text: string, wait?: Promise<void>) {
+  return new ReadableStream<any>({
+    start(controller) {
+      controller.enqueue({ type: 'text-start', id: 't' });
+      void (async () => {
+        await wait;
+        controller.enqueue({ type: 'text-delta', id: 't', delta: text });
+        controller.enqueue({ type: 'text-end', id: 't' });
+        controller.enqueue({
+          type: 'finish', finishReason: { unified: 'stop', raw: undefined },
+          usage: { inputTokens: { total: 2, noCache: 2 },
+            outputTokens: { total: 2, text: 2 } },
+        });
+        controller.close();
+      })();
+    },
+  });
+}
+
+describe('two isolated BotManagers and a single mock lease authority', () => {
+  it('only one overlapping durable job may reach SDK doStream; both queues settle', async () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', '1');
+    const roots = [mkdtempSync(join(tmpdir(), 'merc-fleet-a-')),
+      mkdtempSync(join(tmpdir(), 'merc-fleet-b-'))];
+    const managers: BotManager[] = [];
+    try {
+      const key1 = randomBytes(32), key2 = randomBytes(32);
+      const policies = ['node-x1', 'node-xwing'].map(nodeId => ({
+        nodeId, botId: 'reviewer', provider: 'fixture', model: 'mock-model',
+        upstreamGroup: 'shared-quota-account', maxInputTokens: 100, maxOutputTokens: 10,
+      }));
+      const server = new MockSignedFleetCoordinator({
+        keys: { 'node-x1': key1, 'node-xwing': key2 }, policies,
+      });
+      const clients = [
+        new MockSignedFleetClient('node-x1', key1, message => server.handle(message)),
+        new MockSignedFleetClient('node-xwing', key2, message => server.handle(message)),
+      ];
+      let allowFirstToFinish!: () => void;
+      const firstFinish = new Promise<void>(resolve => { allowFirstToFinish = resolve; });
+      const modelA = new MockLanguageModelV3({ doStream: async () =>
+        ({ stream: completedStream('node A success', firstFinish) }) });
+      const modelB = new MockLanguageModelV3({ doStream: async () =>
+        ({ stream: completedStream('node B should never run') }) });
+      const models = [modelA, modelB];
+      for (let n = 0; n < 2; n++) {
+        const config = getDefaultConfig();
+        config.bots.maxConcurrent = 2;
+        const store = new BotStore(join(roots[n], 'bots'));
+        store.create({ id: 'reviewer', name: 'Reviewer', manifest: {enabled: true} });
+        const provider = {
+          name: 'fixture', model: 'mock-model',
+          getModel: () => 'mock-model', getModelInstance: () => models[n],
+        };
+        const manager = new BotManager({
+          config, store, userMemoryFactory: () => null,
+          providers: { get: () => provider, getDefault: () => provider } as any,
+          tokenBudget: {recordUsage: vi.fn(), getRemaining: () => 100000} as any,
+          fleetAdmission: {
+            authority: clients[n],
+            resolveUpstreamGroup: () => 'shared-quota-account',
+            maxInputTokens: 100, maxOutputTokens: 10,
+          },
+        });
+        managers.push(manager);
+      }
+
+      const a = managers[0].enqueue('reviewer', {trigger: 'chat', prompt: 'node A fixture'});
+      expect(a.accepted).toBe(true);
+      await vi.waitFor(() => expect(modelA.doStreamCalls.length).toBe(1));
+      expect(server.occupiedSlots()).toBe(1);
+
+      const b = managers[1].enqueue('reviewer', {trigger: 'chat', prompt: 'node B fixture'});
+      expect(b.accepted).toBe(true);
+      await vi.waitFor(() => {
+        const j = managers[1].getJournal('reviewer');
+        expect(j).toHaveLength(1);
+        expect(j[0].reasonCode).toBe('fleet_provider_admission_denied');
+      });
+      expect(modelB.doStreamCalls).toHaveLength(0);
+      expect(server.occupiedSlots()).toBe(1);
+
+      allowFirstToFinish();
+      await vi.waitFor(() => {
+        const j = managers[0].getJournal('reviewer');
+        expect(j).toHaveLength(1);
+        expect(j[0].state).toBe('completed');
+      });
+      expect(server.occupiedSlots()).toBe(0);
+      expect(managers[1].getDlq('reviewer')).toHaveLength(1);
+    } finally {
+      for (const manager of managers) manager.dispose();
+      for (const root of roots) rmSync(root, {recursive: true, force: true});
+      vi.unstubAllEnvs();
+    }
+  });
+});
diff --git a/src/bots/fleet-provider-admission.node.check.mjs b/src/bots/fleet-provider-admission.node.check.mjs
new file mode 100644
index 0000000..cba45ed
--- /dev/null
+++ b/src/bots/fleet-provider-admission.node.check.mjs
@@ -0,0 +1,136 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  FleetTurnAdmission, FleetAdmissionDenied, validLease
+} from './fleet-provider-admission.ts';
+
+const request = {
+  taskId: 'job-fixture-0001', botId: 'reviewer', provider: 'fixture',
+  model: 'fixture-only', upstreamGroup: 'synthetic-upstream',
+  maxInputTokens: 100, maxOutputTokens: 10,
+};
+function fake(extra = {}) {
+  let busy = false;
+  const calls = [];
+  const gate = {
+    calls,
+    async acquire(r) {
+      calls.push('acquire');
+      if (busy) return null;
+      busy = true;
+      return { leaseId: 'lease-fixture-0001', ...r, expiresAtMs: Date.now() + 60000 };
+    },
+    async renew(r, l) {
+      calls.push('renew');
+      return { ...l, expiresAtMs: Date.now() + 60000 };
+    },
+    async release(r, l) {
+      calls.push('release');
+      busy = false;
+      return true;
+    },
+    ...extra
+  };
+  return gate;
+}
+const opts = { watchdogMs: 50 };
+
+test('missing coordinator denies without side effects', async () => {
+  await assert.rejects(FleetTurnAdmission.open(null, request), FleetAdmissionDenied);
+});
+test('unqualified group denies before authority call', async () => {
+  const gate = fake();
+  await assert.rejects(FleetTurnAdmission.open(gate, { ...request, upstreamGroup: 'unknown' }), FleetAdmissionDenied);
+  assert.deepEqual(gate.calls, []);
+});
+test('unknown paid provider not inferable from route: coordinator rejects', async () => {
+  const gate = fake({ acquire: async () => null });
+  await assert.rejects(FleetTurnAdmission.open(gate, { ...request, provider: 'paid-provider' }), FleetAdmissionDenied);
+});
+test('wrong upstream response denies (alias must match)', async () => {
+  const gate = fake({ acquire: async (r) => ({ leaseId: 'lease-fixture-0001', ...r,
+    upstreamGroup: 'untrusted-alias', expiresAtMs: Date.now() + 60000 }) });
+  await assert.rejects(FleetTurnAdmission.open(gate, request), FleetAdmissionDenied);
+});
+test('wrong model response denies (must bind exact dispatch)', async () => {
+  const gate = fake({ acquire: async (r) => ({ leaseId: 'lease-fixture-0001', ...r,
+    model: 'changed-after-admission', expiresAtMs: Date.now() + 60000 }) });
+  await assert.rejects(FleetTurnAdmission.open(gate, request), FleetAdmissionDenied);
+});
+test('acquire backend unavailable denies', async () => {
+  await assert.rejects(FleetTurnAdmission.open(fake({ acquire: async () => {throw Error('down')} }), request), FleetAdmissionDenied);
+});
+test('normal lifecycle acquire renew release with immutable identity', async () => {
+  const gate = fake();
+  const lease = await FleetTurnAdmission.open(gate, request, opts);
+  lease.assertLive();
+  await lease.renewOrRevoke();
+  await lease.close();
+  assert.equal(lease.signal.aborted, true);
+  assert.deepEqual(gate.calls, ['acquire', 'renew', 'renew', 'release']);
+  await lease.dispose();
+  assert.equal(gate.calls.filter(c => c === 'release').length, 1);
+});
+test('two same-upstream concurrent clients: only one can acquire', async () => {
+  const gate = fake();
+  const [a, b] = await Promise.allSettled([
+    FleetTurnAdmission.open(gate, request, opts),
+    FleetTurnAdmission.open(gate, { ...request, taskId: 'job-fixture-0002' }, opts)
+  ]);
+  assert.equal([a,b].filter(x => x.status === 'fulfilled').length, 1);
+  await (a.status === 'fulfilled' ? a.value : b.value).dispose();
+});
+test('renew unavailable aborts existing signal and prevents completion', async () => {
+  const gate = fake({ renew: async () => null });
+  const lease = await FleetTurnAdmission.open(gate, request, opts);
+  await assert.rejects(lease.renewOrRevoke(), FleetAdmissionDenied);
+  assert.equal(lease.signal.aborted, true);
+  await assert.rejects(lease.close(), FleetAdmissionDenied);
+  await lease.dispose();
+});
+test('changed lease ID on renew revokes instead of silently swapping generation', async () => {
+  const gate = fake({ renew: async (r,l) => ({ ...l, leaseId: 'lease-attacker-2' }) });
+  const lease = await FleetTurnAdmission.open(gate, request, opts);
+  await assert.rejects(lease.renewOrRevoke(), FleetAdmissionDenied);
+  assert.equal(lease.signal.aborted, true);
+  await lease.dispose();
+});
+test('timer revokes during quiet streaming gaps without a next chunk', async () => {
+  const gate = fake({ renew: async () => null });
+  const lease = await FleetTurnAdmission.open(gate, request, opts);
+  await new Promise(resolve => setTimeout(resolve, 110));
+  assert.equal(lease.signal.aborted, true);
+  await lease.dispose();
+});
+test('release failure cannot claim success', async () => {
+  const gate = fake({ release: async () => false });
+  const lease = await FleetTurnAdmission.open(gate, request, opts);
+  await assert.rejects(lease.close(), FleetAdmissionDenied);
+  assert.equal(lease.signal.aborted, true);
+  await lease.dispose();
+});
+test('expired fixture lease not accepted', async () => {
+  const gate = fake({ acquire: async r => ({ leaseId: 'lease-fixture-0001', ...r, expiresAtMs: Date.now()-1 }) });
+  await assert.rejects(FleetTurnAdmission.open(gate, request), FleetAdmissionDenied);
+});
+test('suspicious multi-day fake lease TTL denied', async () => {
+  const gate = fake({ acquire: async r => ({ leaseId: 'lease-fixture-0001', ...r, expiresAtMs: Date.now()+7*86400_000 }) });
+  await assert.rejects(FleetTurnAdmission.open(gate, request), FleetAdmissionDenied);
+});
+test('invalid cap / request injection fails before authority', async () => {
+  const gate = fake();
+  await assert.rejects(FleetTurnAdmission.open(gate, {...request, maxInputTokens: 0}), FleetAdmissionDenied);
+  await assert.rejects(FleetTurnAdmission.open(gate, {...request, taskId: '../escape'}), FleetAdmissionDenied);
+  assert.deepEqual(gate.calls, []);
+});
+test('invalid watchdog interval rejects and cleans up slot', async () => {
+  const gate = fake();
+  await assert.rejects(FleetTurnAdmission.open(gate,request,{watchdogMs:5}), FleetAdmissionDenied);
+  assert.deepEqual(gate.calls, ['acquire','release']);
+});
+test('strict identity matching on an otherwise valid lease', () => {
+  const l = {leaseId:'lease-fixture-0001', ...request, expiresAtMs:Date.now()+10000};
+  assert.equal(validLease(l,request,Date.now()),true);
+  assert.equal(validLease({...l,botId:'other'},request,Date.now()),false);
+  assert.equal(validLease({...l,taskId:'other'},request,Date.now()),false);
+});
diff --git a/src/bots/fleet-provider-admission.ts b/src/bots/fleet-provider-admission.ts
new file mode 100644
index 0000000..102a36e
--- /dev/null
+++ b/src/bots/fleet-provider-admission.ts
@@ -0,0 +1,213 @@
+/**
+ * Experimental, opt-in, fail-closed provider-call admission for Mercury bot turns.
+ * NO network transport or credentials live here; an authenticated external
+ * coordinator must implement FleetLeaseAuthority before real deployment.
+ *
+ * Intentional first-slice limits: scoped turns get ZERO tools; a no-tool
+ * generation is the only operation protected by the watchdog. Other Mercury
+ * model invocation paths are NOT gated by this module.
+ */
+export interface FleetLeaseRequest {
+  taskId: string;
+  botId: string;
+  provider: string;
+  model: string;
+  upstreamGroup: string;
+  maxInputTokens: number;
+  maxOutputTokens: number;
+}
+
+export interface FleetLease {
+  leaseId: string;
+  taskId: string;
+  botId: string;
+  provider: string;
+  model: string;
+  upstreamGroup: string;
+  expiresAtMs: number;
+}
+
+export interface FleetLeaseAuthority {
+  acquire(request: FleetLeaseRequest): Promise<FleetLease | null>;
+  renew(request: FleetLeaseRequest, lease: FleetLease): Promise<FleetLease | null>;
+  release(request: FleetLeaseRequest, lease: FleetLease): Promise<boolean>;
+}
+
+export class FleetAdmissionDenied extends Error {
+  readonly reason: string;
+  constructor(reason: string) {
+    super('fleet_provider_admission_denied');
+    this.reason = reason;
+    this.name = 'FleetAdmissionDenied';
+  }
+}
+
+export const MIN_WATCHDOG_MS = 50;
+export const DEFAULT_WATCHDOG_MS = 1_000;
+export const MAX_LEASE_TTL_MS = 120_000;
+
+// Not exported: a lease must come from this module's successful acquire.
+const validPermitInstances = new WeakSet<object>();
+
+
+function nonEmpty(value: unknown, maxLength = 256): value is string {
+  return typeof value === 'string' && value.length > 0
+    && value.length <= maxLength && /^[a-zA-Z0-9_.:/@-]+$/.test(value);
+}
+
+function validRequest(r: FleetLeaseRequest): boolean {
+  return typeof r.taskId === 'string' && /^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$/.test(r.taskId)
+    && typeof r.botId === 'string' && /^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$/.test(r.botId)
+    && nonEmpty(r.provider) && nonEmpty(r.model)
+    && nonEmpty(r.upstreamGroup) && r.upstreamGroup !== 'unknown'
+    && Number.isSafeInteger(r.maxInputTokens) && r.maxInputTokens > 0
+    && Number.isSafeInteger(r.maxOutputTokens) && r.maxOutputTokens > 0;
+}
+
+/** The authority's response MUST bind to the exact physical upstream group. */
+export function validLease(lease: FleetLease | null | undefined,
+                           request: FleetLeaseRequest, nowMs: number): lease is FleetLease {
+  return !!lease && nonEmpty(lease.leaseId)
+    && lease.taskId === request.taskId && lease.botId === request.botId
+    && lease.provider === request.provider && lease.model === request.model
+    && lease.upstreamGroup === request.upstreamGroup
+    && Number.isFinite(lease.expiresAtMs)
+    && lease.expiresAtMs > nowMs
+    && lease.expiresAtMs - nowMs <= MAX_LEASE_TTL_MS;
+}
+
+/**
+ * Per-turn lease lifecycle. No retry or new acquire after revocation.
+ * Timer is active throughout an SDK streaming call (including silent gaps).
+ * A lease-lost error must be treated as PERMANENT by the caller.
+ */
+export class FleetTurnAdmission {
+  private revoked = false;
+  private closed = false;
+  private readonly controller = new AbortController();
+  private ticker?: ReturnType<typeof setInterval>;
+  private renewal?: Promise<void>;
+  private readonly authority: FleetLeaseAuthority;
+  readonly request: FleetLeaseRequest;
+  private lease: FleetLease;
+  private readonly clock: () => number;
+  private constructor(authority: FleetLeaseAuthority, request: FleetLeaseRequest,
+                      lease: FleetLease, clock: () => number) {
+    this.authority = authority;
+    this.request = request;
+    this.lease = lease;
+    this.clock = clock;
+  }
+
+  static async open(
+    authority: FleetLeaseAuthority | null | undefined,
+    request: FleetLeaseRequest,
+    opts: { clock?: () => number; watchdogMs?: number } = {},
+  ): Promise<FleetTurnAdmission> {
+    if (!authority || !validRequest(request)
+        || typeof authority.acquire !== 'function'
+        || typeof authority.renew !== 'function'
+        || typeof authority.release !== 'function') {
+      throw new FleetAdmissionDenied('missing_authority_or_unqualified_group');
+    }
+    const clock = opts.clock ?? Date.now;
+    let response: FleetLease | null;
+    try {
+      response = await authority.acquire(request);
+    } catch {
+      throw new FleetAdmissionDenied('acquire_unavailable');
+    }
+    if (!validLease(response, request, clock())) {
+      // If an unusable lease was issued, best-effort release; never generate.
+      const unusable: unknown = response;
+      if (typeof unusable === 'object' && unusable !== null
+          && 'leaseId' in unusable && typeof unusable.leaseId === 'string') {
+        try { await authority.release(request, unusable as FleetLease); } catch { /* must deny */ }
+      }
+      throw new FleetAdmissionDenied('acquire_rejected_or_mismatched');
+    }
+    const admission = new FleetTurnAdmission(authority, request, response, clock);
+    validPermitInstances.add(admission);
+    const watchdogMs = opts.watchdogMs ?? DEFAULT_WATCHDOG_MS;
+    if (!Number.isInteger(watchdogMs) || watchdogMs < MIN_WATCHDOG_MS || watchdogMs > 5_000) {
+      await admission.dispose();
+      throw new FleetAdmissionDenied('invalid_watchdog_interval');
+    }
+    admission.ticker = setInterval(() => {
+      void admission.renewOrRevoke().catch(() => {
+        admission.revoke();
+      });
+    }, watchdogMs);
+    admission.ticker.unref?.();
+    return admission;
+  }
+
+  static wasIssuedHere(value: unknown): value is FleetTurnAdmission {
+    return typeof value === 'object' && value !== null && validPermitInstances.has(value);
+  }
+
+  get signal(): AbortSignal { return this.controller.signal; }
+
+  assertLive(): void {
+    if (this.closed || this.revoked || !validLease(this.lease, this.request, this.clock())) {
+      this.revoke();
+      throw new FleetAdmissionDenied('expired_or_revoked');
+    }
+  }
+
+  /** Terminate the SDK request after observed quota overrun or policy denial. */
+  abortNow(): void { this.revoke(); }
+
+  private revoke(): void {
+    this.revoked = true;
+    if (!this.controller.signal.aborted) this.controller.abort();
+  }
+
+  async renewOrRevoke(): Promise<void> {
+    this.assertLive();
+    if (!this.renewal) {
+      const current = this.lease;
+      this.renewal = (async () => {
+        let fresh: FleetLease | null;
+        try { fresh = await this.authority.renew(this.request, current); }
+        catch { fresh = null; }
+        if (!validLease(fresh, this.request, this.clock()) || fresh.leaseId !== current.leaseId) {
+          this.revoke();
+          throw new FleetAdmissionDenied('renewal_failed_or_mismatched');
+        }
+        if (!this.revoked) this.lease = fresh;
+      })().finally(() => { this.renewal = undefined; });
+    }
+    await this.renewal;
+    this.assertLive();
+  }
+
+  /** Must succeed before the caller reports a successful task. */
+  async close(): Promise<void> {
+    this.assertLive();
+    this.stopTimer();
+    // Do not mark as successful if the final renewal is missing.
+    await this.renewOrRevoke();
+    this.closed = true;
+    let released = false;
+    try { released = await this.authority.release(this.request, this.lease); }
+    catch { /* deny completion */ }
+    this.revoke();
+    if (!released) throw new FleetAdmissionDenied('release_unverified');
+  }
+
+  /** Failure cleanup: never masks the original error, no new generation. */
+  async dispose(): Promise<void> {
+    this.stopTimer();
+    if (this.closed) return;
+    this.closed = true;
+    this.revoke();
+    try { await this.authority.release(this.request, this.lease); }
+    catch { /* failure is recorded by the external authority */ }
+  }
+
+  private stopTimer(): void {
+    if (this.ticker) clearInterval(this.ticker);
+    this.ticker = undefined;
+  }
+}
