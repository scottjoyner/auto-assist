@@ -0,0 +1,223 @@
+import { describe, expect, it, vi } from 'vitest';
+import { randomBytes, createHmac, randomUUID } from 'node:crypto';
+import { MockSignedFleetClient, MockSignedFleetCoordinator, type MockPolicy } from './fleet-mock-coordinator.js';
+import { FleetTurnAdmission } from './fleet-provider-admission.js';
+import { assertFleetRuntimeBootSafe } from '../core/fleet-boot-guard.js';
+import { MockLanguageModelV3 } from 'ai/test';
+import { runBotTurn } from './bot-turn.js';
+
+const keyA = randomBytes(32);
+const keyB = randomBytes(32);
+const policy: MockPolicy[] = [
+  { nodeId: 'node-x1', botId: 'reviewer', provider: 'fixture',
+    model: 'mock-model', upstreamGroup: 'shared-physical-account',
+    maxInputTokens: 100, maxOutputTokens: 10 },
+  { nodeId: 'node-xwing', botId: 'reviewer', provider: 'fixture',
+    model: 'mock-model', upstreamGroup: 'shared-physical-account',
+    maxInputTokens: 100, maxOutputTokens: 10 },
+];
+const req = {
+  taskId: 'mock-fleet-job-0001', botId: 'reviewer',
+  provider: 'fixture', model: 'mock-model',
+  upstreamGroup: 'shared-physical-account',
+  maxInputTokens: 100, maxOutputTokens: 10,
+};
+function fixture(now?: () => number) {
+  const server = new MockSignedFleetCoordinator({
+    keys: { 'node-x1': keyA, 'node-xwing': keyB },
+    policies: policy, now,
+  });
+  const clientA = new MockSignedFleetClient('node-x1', keyA, m => server.handle(m));
+  const clientB = new MockSignedFleetClient('node-xwing', keyB, m => server.handle(m));
+  return { server, clientA, clientB };
+}
+
+describe('authenticated in-process authority fixture, no network / vendor keys', () => {
+  it('two nodes contend against one shared authoritative slot; exactly one admitted', async () => {
+    const { clientA, clientB, server } = fixture();
+    const results = await Promise.all([
+      clientA.acquire(req),
+      clientB.acquire({ ...req, taskId: 'mock-fleet-job-0002' }),
+    ]);
+    expect(results.filter(Boolean)).toHaveLength(1);
+    expect(server.occupiedSlots()).toBe(1);
+    const winner = results[0] ? clientA : clientB;
+    await winner.release(results[0] ? req : { ...req, taskId: 'mock-fleet-job-0002' }, (results[0] ?? results[1])!);
+    expect(server.occupiedSlots()).toBe(0);
+  });
+
+  it('the second node succeeds only after verified release', async () => {
+    const { clientA, clientB } = fixture();
+    const lease = await clientA.acquire(req);
+    expect(lease).toBeTruthy();
+    expect(await clientB.acquire({ ...req, taskId: 'mock-fleet-job-0002' })).toBeNull();
+    expect(await clientA.release(req, lease!)).toBe(true);
+    expect(await clientB.acquire({ ...req, taskId: 'mock-fleet-job-0002' })).toBeTruthy();
+  });
+
+  it('a different model, upstream alias, bot or excessive token caps are denied', async () => {
+    const { clientA, server } = fixture();
+    for (const overrides of [
+      { model: 'paid-model' }, { upstreamGroup: 'fake-free-alias' },
+      { botId: 'other-bot' }, { maxInputTokens: 101 }, { maxOutputTokens: 11 },
+    ]) expect(await clientA.acquire({ ...req, ...overrides })).toBeNull();
+    expect(server.occupiedSlots()).toBe(0);
+  });
+
+  it('wrong HMAC node identity is denied, without a lease', async () => {
+    const { server } = fixture();
+    const impostor = new MockSignedFleetClient('node-xwing', keyA, m => server.handle(m));
+    await expect(impostor.acquire(req)).rejects.toThrow('mock_authentication_failed');
+    expect(server.occupiedSlots()).toBe(0);
+  });
+
+  it('a signed message cannot be replayed to acquire two different slots', async () => {
+    const { server } = fixture();
+    const payload = { nodeId: 'node-x1', nonce: randomUUID(), operation: 'acquire',
+      request: req, lease: null };
+    const mac = createHmac('sha256', keyA).update(JSON.stringify(payload)).digest('hex');
+    const message: any = { payload, mac };
+    expect(server.handle(message).payload.result).toBeTruthy();
+    expect(() => server.handle(message)).toThrow('mock_replayed_message');
+    expect(server.occupiedSlots()).toBe(1);
+  });
+
+  it('an altered signed request is refused', async () => {
+    const { server } = fixture();
+    const payload = { nodeId: 'node-x1', nonce: randomUUID(), operation: 'acquire',
+      request: req, lease: null };
+    const mac = createHmac('sha256', keyA).update(JSON.stringify(payload)).digest('hex');
+    const message: any = { payload: { ...payload, request: { ...req, model: 'changed' } }, mac };
+    expect(() => server.handle(message)).toThrow('mock_authentication_failed');
+    expect(server.occupiedSlots()).toBe(0);
+  });
+
+  it('an altered signed coordinator response is refused by the client', async () => {
+    const { server } = fixture();
+    const client = new MockSignedFleetClient('node-x1', keyA, msg => {
+      const answer = server.handle(msg);
+      return { ...answer, payload: { ...answer.payload, result: null } };
+    });
+    await expect(client.acquire(req)).rejects.toThrow('mock_response_authentication_failed');
+  });
+
+  it('partition removes authority: no client issues a fallback lease', async () => {
+    const { server, clientA, clientB } = fixture();
+    server.setAvailable(false);
+    await expect(clientA.acquire(req)).rejects.toThrow('mock_coordinator_partition');
+    await expect(clientB.acquire({ ...req, taskId: 'mock-fleet-job-0002' })).rejects.toThrow('mock_coordinator_partition');
+    expect(server.occupiedSlots()).toBe(0);
+  });
+
+  it('cross-client release of a lease is denied', async () => {
+    const { server, clientA, clientB } = fixture();
+    const lease = await clientA.acquire(req);
+    expect(lease).toBeTruthy();
+    expect(await clientB.release(req, lease!)).toBe(false);
+    expect(server.occupiedSlots()).toBe(1);
+    expect(await clientA.release(req, lease!)).toBe(true);
+  });
+
+  it('revocation before renew denies the original client', async () => {
+    const { server, clientA } = fixture();
+    const lease = await clientA.acquire(req);
+    server.revokeUpstream(req.upstreamGroup);
+    expect(await clientA.renew(req, lease!)).toBeNull();
+    expect(server.occupiedSlots()).toBe(0);
+  });
+
+  it('expiration permits a new owner and rejects the old lease', async () => {
+    let now = 1000;
+    const { clientA, clientB } = fixture(() => now);
+    const leaseA = await clientA.acquire(req);
+    now += 12001;
+    const leaseB = await clientB.acquire({ ...req, taskId: 'mock-fleet-job-0002' });
+    expect(leaseB).toBeTruthy();
+    expect(await clientA.renew(req, leaseA!)).toBeNull();
+  });
+
+  it('two independent authority copies can still split brain: a deliberate negative witness', async () => {
+    const s1 = fixture(), s2 = fixture();
+    const a = await s1.clientA.acquire(req);
+    const b = await s2.clientB.acquire({ ...req, taskId: 'mock-fleet-job-0002' });
+    expect(a).toBeTruthy();
+    expect(b).toBeTruthy();
+    expect(s1.server.occupiedSlots()).toBe(1);
+    expect(s2.server.occupiedSlots()).toBe(1);
+    // NOT a distributed-failover solution. One surviving authority required.
+  });
+});
+
+describe('startup and actual BotManager turn boundary', () => {
+  it('fleet runtime mode cannot launch a production process with test-only authority', () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', '1');
+    expect(() => assertFleetRuntimeBootSafe()).toThrow('fleet_provider_admission_denied');
+    vi.unstubAllEnvs();
+  });
+
+  it('ordinary startup remains unchanged if no fleet mode was requested', () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', undefined);
+    expect(() => assertFleetRuntimeBootSafe()).not.toThrow();
+    vi.unstubAllEnvs();
+  });
+
+  it('an admitted fake-client lease can guard the real SDK bot turn end to end', async () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', '1');
+    const { clientA, server } = fixture();
+    const mock = new MockLanguageModelV3({
+      doStream: async () => ({ stream: new ReadableStream<any>({
+        start(controller) {
+          controller.enqueue({ type: 'text-start', id: 'txt' });
+          controller.enqueue({ type: 'text-delta', id: 'txt', delta: 'signed fixture complete' });
+          controller.enqueue({ type: 'text-end', id: 'txt' });
+          controller.enqueue({ type: 'finish',
+            finishReason: { unified: 'stop', raw: undefined },
