+/**
+ * Production startup must refuse this experimental fleet mode.
+ * The memory-backed HMAC coordinator is test-only and cannot grant provider
+ * or process admission. Fail BEFORE registering runtime PID or loading keys.
+ */
+import { FleetAdmissionDenied } from '../bots/fleet-provider-admission.js';
+import { isFleetModelGateEnabled } from './fleet-model-gateway.js';
+
+export function assertFleetRuntimeBootSafe(): void {
+  if (isFleetModelGateEnabled()) {
+    throw new FleetAdmissionDenied('fleet_boot_requires_authenticated_durable_authority');
+  }
+}
