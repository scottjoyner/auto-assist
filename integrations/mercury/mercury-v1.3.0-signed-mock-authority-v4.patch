+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { MockLanguageModelV3 } from 'ai/test';
+import { generateText, streamText, FLEET_ADMISSION_SCOPE, isFleetModelGateEnabled } from './fleet-model-gateway.js';
+import { FleetAdmissionDenied, FleetTurnAdmission } from '../bots/fleet-provider-admission.js';
+import fs from 'node:fs';
+import path from 'node:path';
+import ts from 'typescript';
+
+afterEach(() => vi.unstubAllEnvs());
+
+function finish() {
+  return {
+    type: 'finish' as const,
+    finishReason: { unified: 'stop' as const, raw: undefined },
+    usage: {
+      inputTokens: { total: 2, noCache: 2, cacheRead: undefined, cacheWrite: undefined },
+      outputTokens: { total: 2, text: 2, reasoning: undefined },
+    },
+  };
+}
+
+function model() {
+  return new MockLanguageModelV3({
+    doStream: async () => ({
+      stream: new ReadableStream<any>({
+        start(controller) {
+          controller.enqueue({ type: 'text-start', id: 't' });
+          controller.enqueue({ type: 'text-delta', id: 't', delta: 'mock pass' });
+          controller.enqueue({ type: 'text-end', id: 't' });
+          controller.enqueue(finish());
+          controller.close();
+        },
+      }),
+    }),
+  });
+}
+
+function authority() {
+  return {
+    acquire: vi.fn(async (r: any) => ({ ...r, leaseId: 'lease-fleet-0001', expiresAtMs: Date.now() + 60_000 })),
+    renew: vi.fn(async (_r: any, l: any) => ({ ...l, expiresAtMs: Date.now() + 60_000 })),
+    release: vi.fn(async () => true),
+  };
+}
+
+const request = {
+  taskId: 'sdk-fleet-task-0001', botId: 'guarded-bot', provider: 'fixture',
+  model: 'fixture-model', upstreamGroup: 'synthetic-upstream',
+  maxInputTokens: 100, maxOutputTokens: 10,
+};
+
+describe('fleet-wide direct SDK model gate (mock-only)', () => {
+  it('an unknown fleet mode is treated as armed, not permissive', () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', 'typo-that-must-deny');
+    expect(isFleetModelGateEnabled()).toBe(true);
+    const m = model();
+    expect(() => streamText({ model: m, prompt: 'test' })).toThrow(FleetAdmissionDenied);
+    expect(m.doStreamCalls).toHaveLength(0);
+  });
+
+  it('unscoped direct generateText is denied before a provider request', () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', 'deny_unscoped');
+    const m = model();
+    expect(() => generateText({ model: m, prompt: 'test' })).toThrow(FleetAdmissionDenied);
+    expect(m.doGenerateCalls).toHaveLength(0);
+  });
+
+  it('unscoped direct streamText is denied before the model doStream', () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', 'deny_unscoped');
+    const m = model();
+    expect(() => streamText({ model: m, prompt: 'test' })).toThrow(FleetAdmissionDenied);
+    expect(m.doStreamCalls).toHaveLength(0);
+  });
+
+  it('fake lease object cannot smuggle direct model access', () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', 'deny_unscoped');
+    const m = model();
+    const forged = { assertLive() {}, signal: new AbortController().signal };
+    expect(() => streamText({
+      model: m, prompt: 'test', [FLEET_ADMISSION_SCOPE]: forged,
+    } as any)).toThrow(FleetAdmissionDenied);
+    expect(m.doStreamCalls).toHaveLength(0);
+  });
+
+  it('rejects an unminted object carrying the real lease prototype', () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', '1');
+    const forged = Object.create(FleetTurnAdmission.prototype);
+    const m = model();
+    expect(() => streamText({model: m, prompt: 'test',
+      [FLEET_ADMISSION_SCOPE]: forged} as any)).toThrow(FleetAdmissionDenied);
+    expect(m.doStreamCalls).toHaveLength(0);
+  });
+
+  it('a genuine live lease admits exactly one SDK mock-stream request', async () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', 'deny_unscoped');
+    const gate = authority();
+    const permit = await FleetTurnAdmission.open(gate, request);
+    const m = model();
+    const stream = streamText({
+      model: m, prompt: 'test', tools: {},
+      [FLEET_ADMISSION_SCOPE]: permit,
+      abortSignal: permit.signal,
+    } as any);
+    expect(await stream.text).toBe('mock pass');
+    expect(m.doStreamCalls).toHaveLength(1);
+    await permit.close();
+    expect(gate.release).toHaveBeenCalledOnce();
+  });
+
+  it('a genuine live lease cannot permit any tool-capable SDK request', async () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', 'deny_unscoped');
+    const gate = authority();
+    const permit = await FleetTurnAdmission.open(gate, request);
+    const m = model();
+    const invalidToolRequest = {
+      model: m, prompt: 'test',
+      tools: { run_command: { execute: async () => 'no' } } as any,
+      [FLEET_ADMISSION_SCOPE]: permit,
+    };
+    expect(() => streamText(invalidToolRequest)).toThrow(FleetAdmissionDenied);
+    expect(m.doStreamCalls).toHaveLength(0);
+    await permit.dispose();
+  });
+
+  it('an expired/revoked lease cannot be reused in SDK generation', async () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', 'deny_unscoped');
+    const gate = authority();
+    const permit = await FleetTurnAdmission.open(gate, request);
+    await permit.dispose();
+    const m = model();
+    const staleRequest = {model: m, prompt: 'test', [FLEET_ADMISSION_SCOPE]: permit};
+    expect(() => streamText(staleRequest)).toThrow(FleetAdmissionDenied);
+    expect(m.doStreamCalls).toHaveLength(0);
+  });
+
+  it('an explicit off-looking flag still prevents unscoped SDK generation', async () => {
+    vi.stubEnv('MERCURY_FLEET_MODEL_GATE', 'off');
+    expect(isFleetModelGateEnabled()).toBe(true);
+    const m = model();
+    expect(() => streamText({model: m, prompt: 'test'})).toThrow(FleetAdmissionDenied);
+    expect(m.doStreamCalls).toHaveLength(0);
+  });
+});
+
+describe('source callsite coverage: no unguarded direct AI SDK model import', () => {
+  it('guards all direct generateText/streamText imports throughout production source', () => {
+    const root = path.resolve(import.meta.dirname, '..');
+    const violations: string[] = [];
+    const seen = new Set<string>();
+    function scan(dir: string) {
+      for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+        const full = path.join(dir, entry.name);
+        if (entry.isDirectory()) { scan(full); continue; }
+        if (!entry.isFile() || !/\.[cm]?[jt]sx?$/.test(entry.name) || /\.(test|spec)\./.test(entry.name)) continue;
+        const rel = path.relative(root, full).replaceAll(path.sep, '/');
+        const source = fs.readFileSync(full, 'utf8');
+        const ast = ts.createSourceFile(rel, source, ts.ScriptTarget.Latest, true);
+        for (const stmt of ast.statements) {
+          if (!ts.isImportDeclaration(stmt) || !ts.isStringLiteral(stmt.moduleSpecifier)
+              || stmt.moduleSpecifier.text !== 'ai') continue;
+          const clause = stmt.importClause;
+          if (clause?.namedBindings && ts.isNamespaceImport(clause.namedBindings)) {
+            violations.push(rel + ': namespace import of ai');
+          } else if (clause?.namedBindings && ts.isNamedImports(clause.namedBindings)) {
+            for (const spec of clause.namedBindings.elements) {
+              const name = (spec.propertyName ?? spec.name).text;
+              if (name === 'generateText' || name === 'streamText') {
+                if (rel !== 'core/fleet-model-gateway.ts') {
+                  violations.push(rel + ': direct import ' + name);
+                }
+                seen.add(rel);
+              }
+            }
+          }
+        }
+        if (/\brequire\(['"]ai['"]\)|\bimport\(['"]ai['"]\)/.test(source)) {
+          violations.push(rel + ': dynamic ai import requires audit');
+        }
+      }
+    }
+    scan(root);
+    expect(violations).toEqual([]);
+    expect(seen.has('core/fleet-model-gateway.ts')).toBe(true);
+  });
+});
