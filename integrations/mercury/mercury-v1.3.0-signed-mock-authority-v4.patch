--- /dev/null
+++ b/src/core/fleet-model-gateway.ts
@@ -0,0 +1,52 @@
+/**
+ * Experimental fleet-wide AI SDK ingress. Enabled ONLY when the environment
+ * contains MERCURY_FLEET_MODEL_GATE (any defined value).
+ * Standalone upstream behavior is unchanged when unset.
+ *
+ * This does NOT issue provider permits or authenticate lease authorities:
+ * only the independently admitted bot turn has a live FleetTurnAdmission.
+ * Other callers fail before SDK model dispatch. No token/secret logging.
+ */
+import { generateText as sdkGenerateText, streamText as sdkStreamText } from 'ai';
+import { FleetAdmissionDenied, FleetTurnAdmission } from '../bots/fleet-provider-admission.js';
+
+/** Unique, non-string scope marker removed before calling the vendor SDK. */
+export const FLEET_ADMISSION_SCOPE: unique symbol = Symbol('mercury.fleet.admitted');
+export type FleetScopedOptions = { [FLEET_ADMISSION_SCOPE]?: FleetTurnAdmission };
+
+export function isFleetModelGateEnabled(): boolean {
+  // Any defined value, including 'off', denies unscoped generation.
+  return process.env.MERCURY_FLEET_MODEL_GATE !== undefined;
+}
+
+export function assertFleetModelPermission(scope?: unknown): void {
+  if (scope !== undefined && scope !== null) {
+    if (!FleetTurnAdmission.wasIssuedHere(scope)) {
+      throw new FleetAdmissionDenied('invalid_fleet_sdk_scope');
+    }
+    scope.assertLive();
+  } else if (isFleetModelGateEnabled()) {
+    throw new FleetAdmissionDenied('unscoped_sdk_generation_disabled');
+  }
+}
+
+/** Every direct generateText request is denied in experimental fleet mode. */
+export const generateText: typeof sdkGenerateText = ((options: any) => {
+  assertFleetModelPermission();
+  return sdkGenerateText(options);
+}) as typeof sdkGenerateText;
+
+/**
+ * Scoped streamText requests pass only after a valid lease. The symbol is
+ * stripped before the SDK receives options. No tools can run when scoped;
+ * caller also explicitly sends an empty tool map.
+ */
+export const streamText: typeof sdkStreamText = ((options: any) => {
+  const scope = options?.[FLEET_ADMISSION_SCOPE] as unknown;
+  assertFleetModelPermission(scope);
+  if (FleetTurnAdmission.wasIssuedHere(scope) && options.tools && Object.keys(options.tools).length) {
+    throw new FleetAdmissionDenied('fleet_sdk_tools_forbidden');
+  }
+  const { [FLEET_ADMISSION_SCOPE]: ignored, ...sdkOptions } = options ?? {};
+  return sdkStreamText(sdkOptions);
+}) as typeof sdkStreamText;
