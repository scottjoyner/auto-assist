+/**
+ * Real ai.streamText + ai/test MockLanguageModelV3. Absolutely no HTTP
+ * inference, credentials, providers, or installed Mercury services.
+ * Do NOT vi.mock('ai') here: this tests the actual SDK stream pipeline.
+ */
+import { describe, it, expect, vi } from 'vitest';
+import { MockLanguageModelV3 } from 'ai/test';
+import { runBotTurn } from './bot-turn.js';
+
+function gate(override: Partial<Record<'acquire' | 'renew' | 'release', any>> = {}) {
+  return {
+    acquire: vi.fn(async (r: any) => ({
+      ...r, leaseId: 'lease-sdk-0001', expiresAtMs: Date.now() + 60_000,
+    })),
+    renew: vi.fn(async (_r: any, l: any) => ({
+      ...l, expiresAtMs: Date.now() + 60_000,
+    })),
+    release: vi.fn(async () => true),
+    ...override,
+  };
+}
+
+function makeInput(model: MockLanguageModelV3, authority: any) {
+  return {
+    manifest: { id: 'audit-bot', name: 'Audit bot', enabled: true,
+      autonomy: { maxSteps: 2 } },
+    trigger: 'api' as const,
+    jobId: 'mock-sdk-task-0001',
+    prompt: 'return bounded fixture result',
+    persona: 'read-only experiment',
+    mail: [],
+    pollMail: () => [],
+    sandbox: { workspace: '/tmp/mock-merc-ws', shared: '/tmp/mock-merc-shared' },
+    capabilities: {} as any,
+    tools: { run_command: { execute: async () => 'unsafe' } as any },
+    userMemory: null,
+    provider: {
+      name: 'fixture',
+      getModel: () => 'fixture-model',
+      getModelInstance: () => model,
+    } as any,
+    tokenBudget: { recordUsage: vi.fn(), getRemaining: () => 99999 } as any,
+    abortSignal: new AbortController().signal,
+    fleetAdmission: {
+      authority, upstreamGroup: 'synthetic-upstream',
+      maxInputTokens: 100, maxOutputTokens: 20,
+    },
+  };
+}
+
+function finish() {
+  return {
+    type: 'finish' as const,
+    finishReason: { unified: 'stop' as const, raw: undefined },
+    usage: {
+      inputTokens: { total: 5, noCache: 5, cacheRead: undefined, cacheWrite: undefined },
+      outputTokens: { total: 2, text: 2, reasoning: undefined },
+    },
+  };
+}
+
+describe('actual SDK-stream transport: mock language model, no network', () => {
+  it('denied admission never invokes the SDK model doStream', async () => {
+    const model = new MockLanguageModelV3({
+      doStream: async () => { throw Error('provider must not start'); },
+    });
+    const authority = gate({ acquire: vi.fn(async () => null) });
+    const output = await runBotTurn(makeInput(model, authority));
+    expect(output.reasonCode).toBe('fleet_provider_admission_denied');
+    expect(model.doStreamCalls).toHaveLength(0);
+  });
+
+  it('real SDK stream completes only with a valid lease and cannot run a tool', async () => {
+    const model = new MockLanguageModelV3({
+      doStream: async () => ({
+        stream: new ReadableStream({
+          start(controller) {
+            controller.enqueue({ type: 'text-start', id: 'txt' });
+            controller.enqueue({ type: 'text-delta', id: 'txt', delta: 'bounded mock' });
+            controller.enqueue({ type: 'text-end', id: 'txt' });
+            controller.enqueue(finish());
+            controller.close();
+          },
+        }),
+      }),
+    });
+    const authority = gate();
+    const opts = makeInput(model, authority);
+    const output = await runBotTurn(opts);
+    expect(output.status).toBe('completed');
+    expect(output.output).toBe('bounded mock');
+    expect(model.doStreamCalls).toHaveLength(1);
+    expect(authority.acquire).toHaveBeenCalledOnce();
+    expect(authority.renew.mock.calls.length).toBeGreaterThanOrEqual(2);
+    expect(authority.release).toHaveBeenCalledOnce();
+    expect(opts.tokenBudget.recordUsage).toHaveBeenCalledOnce();
+  });
+
+  it('quiet SDK stream receives an abort when watchdog renewal is rejected', async () => {
+    let observedAbort = false;
+    let started = false;
+    const model = new MockLanguageModelV3({
+      doStream: async (options) => ({
+        stream: new ReadableStream({
+          start(controller) {
+            started = true;
+            controller.enqueue({ type: 'text-start', id: 'txt' });
+            controller.enqueue({ type: 'text-delta', id: 'txt', delta: 'partial' });
+            options.abortSignal?.addEventListener('abort', () => {
+              observedAbort = true;
+              controller.error(new Error('mock transport aborted'));
+            }, { once: true });
+            // Intentionally never finish. Only the lease watchdog can stop it.
+          },
+        }),
+      }),
+    });
+    const authority = gate({
+      renew: vi.fn()
+        .mockImplementationOnce(async (_r: any, l: any) => ({
+          ...l, expiresAtMs: Date.now() + 60_000,
+        }))
+        .mockImplementationOnce(async (_r: any, l: any) => ({
+          ...l, expiresAtMs: Date.now() + 60_000,
+        }))
+        .mockImplementation(async () => null),
+    });
+    const output = await Promise.race([
+      runBotTurn(makeInput(model, authority)),
+      new Promise<never>((_resolve, reject) =>
+        setTimeout(() => reject(new Error('mock abort exceeded 2500ms')), 2500)),
+    ]);
+    expect(started).toBe(true);
+    expect(observedAbort).toBe(true);
+    expect(output.status).not.toBe('completed');
+    expect(output.reasonCode).toBe('fleet_provider_admission_denied');
+    expect(authority.release).toHaveBeenCalledOnce();
+  });
+});
