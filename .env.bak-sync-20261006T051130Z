# ---- LLM Backend ----
# Backend: "openai" (LM Studio / OpenAI API) or "ollama"
LLM_BACKEND=openai
# TESTING: route the agent "decide" step to OpenRouter hy3:free (assistx-only
# free key) for fast, free iterative runs. The fleet executor still probes the
# live LM Studio nodes and adds them as fallbacks via FLEET_STATE_PATH.
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=not-needed
LLM_TIMEOUT_S=45
LLM_CB_FAIL_THRESHOLD=9999
