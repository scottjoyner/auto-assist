# REQUIRED exact clean git HEAD; empty intentionally disables deployment.
KIPNERTER_GATEWAY_SOURCE_SHA=
# Operator statement ONLY; never substitutes for physical header-stripping proof.
KIPNERTER_LEGACY_CADDY_FENCE_CONFIRMED=0
# Must be independently witnessed; this preflight script does NOT activate Serve.
KIPNERTER_GATEWAY_AUTH_NEGATIVE_TEST_VERIFIED=0
