# Kipnerter Tailnet mobile gateway overlay
#
# Merge these non-secret values into the production AssistX .env before
# enabling the identity-trusting Tailscale Serve boundary. Keep the raw
# AssistX host port loopback-only while TRUSTED_AUTH_HEADER is enabled.

ASSISTX_API_BIND=127.0.0.1
ASSISTX_API_PORT=8000
TRUSTED_AUTH_HEADER=Tailscale-User-Login

# Optional but recommended application allowlist. Use the Tailscale login(s)
# that should be allowed to use the Kipnerter mobile surface.
KIPNERTER_TAILNET_ALLOWED_LOGINS=

# Fleet Auto remains server-routed by default. Do not let the phone choose an
# arbitrary backend model unless this is deliberately enabled for testing.
KIPNERTER_AGENT_ALLOW_MODEL_OVERRIDE=0
KIPNERTER_AGENT_TIMEOUT=300
