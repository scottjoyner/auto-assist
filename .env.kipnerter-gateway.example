# TEMPLATE ONLY — do not source into production until ingress #149 has
# independent physical spoof-header negatives, exact host binding and operator
# approval. This file has NO credentials or live identity values.
#
# Legacy Caddy on x1-370 can forward Tailscale-looking headers unless its
# stripping/injection chain has been independently verified. Loopback-only
# binding alone does not establish header provenance.
ASSISTX_API_BIND=127.0.0.1
TRUSTED_AUTH_HEADER=Tailscale-User-Login
KIPNERTER_AGENT_ALLOW_MODEL_OVERRIDE=0
KIPNERTER_TAILNET_ALLOWED_LOGINS=
KIPNERTER_GATEWAY_SERVE_PORT=8443

# Fail closed by default. Neither variable proves ingress security.
KIPNERTER_GATEWAY_APPLY=0
KIPNERTER_LEGACY_CADDY_FENCE_CONFIRMED=0

# The apply helper requires an exact, externally approved 40-hex source SHA:
KIPNERTER_GATEWAY_SOURCE_SHA=
# An explicit independent negative-test witness is mandatory for apply.
KIPNERTER_GATEWAY_NEGATIVE_WITNESS_FILE=
