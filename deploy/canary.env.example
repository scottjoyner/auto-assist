# Copy to an untracked file such as deploy/canary.env and replace every
# placeholder. The deployment scripts refuse placeholder values.

COMPOSE_PROJECT_NAME=assistx-canary
CANARY_API_PORT=18000
CANARY_BASE_URL=http://127.0.0.1:18000
CANARY_NETWORK_NAME=assistx_canary_default
CANARY_STAGES=observe,cache
CANARY_NODE_ID=assistx-canary
CANARY_NODE_TOKEN=replace-with-node-specific-token
CANARY_RECOVERY_NODE_ID=xwing
CANARY_MIGRATION_SOURCE=xwing
CANARY_MIGRATION_DESTINATION=x1-370
CANARY_MANAGED_NEO4J=false
CANARY_START_HERMES=false
CANARY_IMPROVEMENT_REPOSITORY=auto-assist
ASSISTX_API_BIND=127.0.0.1
ASSISTX_API_PORT=18000
ASSISTX_NEO4J_BIND=127.0.0.1
ASSISTX_NEO4J_BOLT_PORT=17687

ASSISTX_RUNTIME_PROFILE=production
ASSISTX_DEPENDENCY_MODE=production
BASIC_AUTH_USER=canary-operator
BASIC_AUTH_PASS=replace-with-unique-canary-password

# Use an existing Neo4j for the first branch-image canary. Set
# CANARY_MANAGED_NEO4J=true and bolt://neo4j:7687 for an isolated database.
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-database-password
NEO4J_DATABASE=assistx
REDIS_URL=redis://redis:6379/0

LLM_BACKEND=openai
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=not-needed
LLM_MODEL=replace-with-loaded-model-id
EMBED_MODEL=nomic-embed-text
WORKER_CONCURRENCY=1

ASSISTX_OVERLAY_MODE=direct
AUTO_ROUTER_BASE_URL=
AUTO_ASSIGN_BASE_URL=

FLEET_UNSAFE_SHELL_TASKS_ENABLED=false
ASSISTX_REPO_TASK_GENERATOR_ENABLED=false
ASSISTX_REPO_TASK_AUTO_READY=false
ASSISTX_RECOVERY_EXECUTION_ENABLED=false
FLEET_RECOVERY_RUNBOOKS_ENABLED=false

ASSISTX_KV_PREFIX_HMAC_SECRET=replace-with-separate-random-secret
ASSISTX_FLEET_NODE_TOKENS={"assistx-canary":"replace-with-node-specific-token","xwing":"replace-with-recovery-node-token"}
FLEET_NODE_TOKEN=replace-with-node-specific-token
FLEET_KV_CACHE_RUNTIME=lmstudio
FLEET_KV_CACHE_CONTROL_URL=

# Configure these before adding "improvement" to CANARY_STAGES.
ASSISTX_REPOSITORY_ROOTS_JSON={"auto-assist":"/home/scott/git/auto-assist"}
ASSISTX_IMPROVEMENT_WORKTREE_ROOT=/var/lib/assistx/improvement-worktrees
ASSISTX_IMPROVEMENT_ATTESTATION_KEY_ID=xwing-improvement-v1
ASSISTX_IMPROVEMENT_ATTESTATION_SECRET=replace-with-node-specific-secret
ASSISTX_IMPROVEMENT_VERIFY_KEYS={"xwing-improvement-v1":"replace-with-node-specific-secret"}

# Configure and enable these only before adding "recovery" to CANARY_STAGES.
ASSISTX_RUNBOOK_SIGNING_KEYS={"runbook-canary-v1":"replace-with-32-byte-secret"}
ASSISTX_RUNBOOK_ACTIVE_KEY_ID=runbook-canary-v1
FLEET_RUNBOOK_VERIFY_KEYS={"runbook-canary-v1":"replace-with-32-byte-secret"}
FLEET_RECOVERY_SERVICE_ALIASES={"inference":{"adapter":"observation","instructions":"Canary health check only"}}
