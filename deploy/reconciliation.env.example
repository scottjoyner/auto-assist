# Live-safe side-by-side reconciliation environment.
# Copy to deploy/reconciliation.env, chmod 600, and replace every change-me value.
# Never reuse production signing keys or node tokens in the shadow stack.

# Isolated project identity and the dedicated cross-project router network.
COMPOSE_PROJECT_NAME=assistx_reconciliation
CANARY_NETWORK_NAME=assistx_reconciliation_shared
RECONCILIATION_ASSISTX_NETWORK=assistx_reconciliation_shared
CANARY_SOURCE_REVISION=full-auto-reconciliation-20260730
CANARY_STAGES=observe,cache

# Loopback-only shadow ports
ASSISTX_API_BIND=127.0.0.1
ASSISTX_API_PORT=18000
ASSISTX_NEO4J_BIND=127.0.0.1
ASSISTX_NEO4J_BOLT_PORT=17687

# Use an isolated Neo4j container and database for the first pass.
CANARY_MANAGED_NEO4J=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-shadow-neo4j
NEO4J_DATABASE=assistx_reconciliation
NEO4J_CACHE_SIZE=512M
NEO4J_HEAP_SIZE=1G

# Shadow API credentials
BASIC_AUTH_USER=reconciliation-admin
BASIC_AUTH_PASS=change-me-shadow-api
ASSISTX_USER=reconciliation-admin
ASSISTX_PASS=change-me-shadow-api
FLEET_BASIC_AUTH_USER=reconciliation-admin
FLEET_BASIC_AUTH_PASS=change-me-shadow-api

# Router-only offline topology. Containers communicate on the dedicated shared
# Docker network; host-published APIs remain bound to 127.0.0.1.
ASSISTX_OVERLAY_MODE=router
AUTO_ROUTER_BASE_URL=http://auto-router-reconciliation:8088
AUTO_ASSIGN_BASE_URL=
FLEET_ROUTER_URL=http://auto-router-reconciliation:8088
OPENAI_BASE_URL=http://auto-router-reconciliation:8088/v1
OPENAI_API_KEY=local-offline-only
LLM_BACKEND=openai
LLM_MODEL=local/reconciliation-default
EMBED_MODEL=nomic-embed-text

# Conservative execution defaults
WORKER_CONCURRENCY=1
RQ_JOB_TIMEOUT_S=900
LLM_TIMEOUT_S=60
TASK_WALLCLOCK_S=300
HERMES_SELFTASK_ENABLED=false
HERMES_MAX_TASKS_PER_LOOP=1
HERMES_PROVIDER=assistx-router
HERMES_LM_BASE_URL=http://auto-router-reconciliation:8088/v1
HERMES_MODEL=local/reconciliation-default
HERMES_SMOKE_MODEL=local/reconciliation-default
CANARY_START_HERMES=false

# All mutation authority stays off during shadow mode
ASSISTX_RECOVERY_EXECUTION_ENABLED=false
FLEET_RECOVERY_RUNBOOKS_ENABLED=false
FLEET_UNSAFE_SHELL_TASKS_ENABLED=false
ASSISTX_REPO_TASK_GENERATOR_ENABLED=false
ASSISTX_REPO_TASK_AUTO_READY=false
CANARY_EXECUTE_IMPROVEMENT=false
CANARY_EXECUTE_RECOVERY=false

# Shadow-only secrets. Replace with independently generated values.
ASSISTX_RUNBOOK_SIGNING_KEYS={"shadow-runbook-v1":"change-me-shadow-runbook-key"}
ASSISTX_RUNBOOK_ACTIVE_KEY_ID=shadow-runbook-v1
FLEET_RUNBOOK_VERIFY_KEYS={"shadow-runbook-v1":"change-me-shadow-runbook-key"}
ASSISTX_FLEET_NODE_TOKENS={"shadow-node":"change-me-shadow-node-token"}
FLEET_NODE_TOKEN=change-me-shadow-node-token
ASSISTX_IMPROVEMENT_ATTESTATION_KEY_ID=shadow-node-v1
ASSISTX_IMPROVEMENT_ATTESTATION_SECRET=change-me-shadow-attestation
ASSISTX_IMPROVEMENT_VERIFY_KEYS={"shadow-node-v1":"change-me-shadow-attestation"}
ASSISTX_KV_PREFIX_HMAC_SECRET=change-me-shadow-kv-secret

# Empty by design: no hosted inference or legacy assignment service.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
CLOUDFLARE_API_TOKEN=
AUTO_ROUTER_AGENTGATEWAY_ENABLED=false

# Optional preflight settings
RECONCILIATION_LMS_HOSTS=x1-370
RECONCILIATION_OLD_ASSISTX_URL=http://127.0.0.1:8000
RECONCILIATION_OLD_ROUTER_URL=http://127.0.0.1:8088
RECONCILIATION_NEW_ASSISTX_URL=http://127.0.0.1:18000
RECONCILIATION_NEW_ROUTER_URL=http://127.0.0.1:18088
