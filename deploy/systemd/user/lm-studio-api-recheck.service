[Unit]
Description=Bounded LM Studio API availability check (no model loading)
After=network-online.target lm-studio-api-start.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /home/scott/.local/bin/lmstudio-api-recheck.py
TimeoutStartSec=45
NoNewPrivileges=true
UMask=0077
