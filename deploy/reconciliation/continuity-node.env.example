# Lightweight bounded continuity worker for an LM Studio or verification node.
# Copy to /etc/assistx-continuity/node.env and chmod 600.

FLEET_NODE_ID=xwing

# LAN first, Tailscale fallback. Both URLs must resolve to the same continuity
# controller identity and epoch stream.
FLEET_CONTINUITY_URLS=http://192.168.1.20:28200,http://100.64.0.20:28200
FLEET_CONTINUITY_CLUSTER_ID=assistx-fleet
FLEET_CONTINUITY_EXPECTED_CONTROLLER_IDS=beelink-recovery
FLEET_CONTINUITY_TOKEN_FILE=/etc/assistx-continuity/continuity-token
FLEET_CONTINUITY_STATE_DIR=/var/lib/assistx-continuity
FLEET_CONTINUITY_POLL_INTERVAL=10
FLEET_CONTINUITY_CLAIM_TTL_MS=900000

# The emergency worker has no shell, script, SSH, browser, or repository handler.
FLEET_CONTINUITY_ALLOWED_TASK_KINDS=runtime_probe,http_probe,artifact_checksum,backup_verify
FLEET_CONTINUITY_CAPABILITIES=

# Optional local LM Studio endpoint. The agent probes only /v1/models.
FLEET_LMSTUDIO_URL=http://127.0.0.1:1234

# Comma-separated local roots allowed for checksum/backup verification. Customize
# the systemd ReadOnlyPaths line to match these exact roots.
FLEET_CONTINUITY_ARTIFACT_ROOTS=/var/lib/assistx-backups,/mnt/recovery-artifacts

# Exact private URL prefixes eligible for GET-only health probes.
FLEET_CONTINUITY_HTTP_ALLOWLIST=http://127.0.0.1:1234,http://127.0.0.1:8088
