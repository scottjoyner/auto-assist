# Dedicated Beelink recovery-island host agent. Keep this file mode 0600.
# The recovery node is an executor only; AssistX/Neo4j remains authority.

FLEET_NODE_ID=beelink-recovery
FLEET_ASSISTX_URL=http://192.168.1.10:8000
FLEET_AUTH_USER=replace-with-node-specific-basic-user
FLEET_AUTH_PASS=replace-with-node-specific-basic-password
FLEET_NODE_TOKEN=replace-with-node-specific-token
FLEET_POLL_INTERVAL=15
FLEET_TASK_HEARTBEAT_SECONDS=15
FLEET_TASK_LEASE_SECONDS=900
FLEET_RECOVERY_ISLAND_STATE_DIR=/var/lib/assistx-recovery/state

# Do not place signing material inline in this environment file. The agent
# refuses key files that are group/world readable.
FLEET_RECOVERY_ISLAND_RUNBOOK_VERIFY_KEYS_FILE=/etc/assistx-recovery/runbook-verify-keys.json
FLEET_RECOVERY_ISLAND_ACTIVATION_VERIFY_KEYS_FILE=/etc/assistx-recovery/activation-verify-keys.json

# Static deployment allowlist. It contains the automatically activatable shadow
# tier and the separately promoted executor tier.
FLEET_RECOVERY_ISLAND_DEPLOYMENTS_FILE=/etc/assistx-recovery/deployments.json

# Values used for Compose interpolation on every config/up/stop invocation.
FLEET_RECOVERY_ISLAND_COMPOSE_ENV_FILE=/srv/assistx-recovery/deployment/recovery-island.env

# Rootless Docker is preferred. Point this at the recovery service account's
# rootless socket; use the actual UID allocated during installation.
DOCKER_HOST=unix:///run/user/1002/docker.sock
