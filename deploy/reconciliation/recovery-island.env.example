# Dedicated Beelink recovery-island agent. Keep this file mode 0600.
# The recovery node is an executor only; AssistX/Neo4j remains authority.

FLEET_NODE_ID=beelink-recovery
FLEET_ASSISTX_URL=http://192.168.1.10:8000
FLEET_AUTH_USER=admin
FLEET_AUTH_PASS=replace-me
FLEET_NODE_TOKEN=replace-with-node-specific-token
FLEET_POLL_INTERVAL=15
FLEET_TASK_HEARTBEAT_SECONDS=15
FLEET_TASK_LEASE_SECONDS=900
FLEET_RECOVERY_ISLAND_STATE_DIR=/var/lib/assistx-recovery/state

# Routine runbooks can stage, verify, activate, or deactivate only the static
# deployment entries below. Rotate this separately from activation keys.
FLEET_RUNBOOK_VERIFY_KEYS={"runbook-v1":"replace-with-runbook-verification-secret"}

# Activation is a distinct privilege. The Beelink will not become active merely
# because it received a normal recovery runbook.
FLEET_RECOVERY_ACTIVATION_VERIFY_KEYS={"activation-v1":"replace-with-activation-verification-secret"}

# All paths are local to the Beelink. Artifacts should be pushed one-way from the
# primary system; the recovery node should not hold an SSH key for the primary.
FLEET_RECOVERY_ISLAND_DEPLOYMENTS={"assistx":{"project_directory":"/srv/assistx-recovery/deployment","project_name":"assistx_recovery_island","compose_files":["compose.recovery.yml"],"services":["neo4j-restore","neo4j","redis","assistx-api","assistx-worker","auto-router"],"bundle_path":"/var/lib/assistx-recovery/bundles/reconciliation-images.tar","manifest_path":"/var/lib/assistx-recovery/bundles/reconciliation-images.manifest.json","bundle_sha256":"replace-with-64-character-sha256","health_urls":["http://127.0.0.1:28000/health","http://127.0.0.1:28088/health"]}}

# Rootless Docker is preferred. Point this at the recovery user's socket.
DOCKER_HOST=unix:///run/user/1002/docker.sock
