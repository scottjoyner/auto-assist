# Primary-side projection replicator. Copy to
# /etc/assistx-continuity/replicator.env and chmod 600.

# LAN first, Tailscale fallback. Both addresses must identify the same Beelink
# continuity controller and expose the same monotonic recovery epoch.
ASSISTX_CONTINUITY_REPLICATION_TARGET_URLS=http://192.168.1.20:28200,http://100.64.0.20:28200
ASSISTX_CONTINUITY_REPLICATION_TARGET_TOKEN_FILE=/etc/assistx-continuity/continuity-token
ASSISTX_CONTINUITY_CLUSTER_ID=assistx-fleet
ASSISTX_CONTINUITY_EXPECTED_CONTROLLER_IDS=beelink-recovery
ASSISTX_CONTINUITY_REPLICATION_INTERVAL_SECONDS=20

# Source only from the authoritative local AssistX API. Keep the password in a
# separate mode-0600 file so it never appears in process arguments.
ASSISTX_CONTINUITY_REPLICATION_SOURCE_BASE_URL=http://127.0.0.1:8000
ASSISTX_CONTINUITY_REPLICATION_SOURCE_USER=continuity-replicator
ASSISTX_CONTINUITY_REPLICATION_SOURCE_PASS_FILE=/etc/assistx-continuity/source-basic-password

# Optional explicit document contract. Leave empty to replicate the default
# runtime projection and optional context projection endpoints from the source
# base URL. Custom entries must use a supported validator.
ASSISTX_CONTINUITY_REPLICATION_DOCUMENTS_JSON=
