# Primary AssistX policy for the Beelink continuity controller.
# These values belong on the authoritative primary controller, not on the Beelink.

ASSISTX_RECOVERY_ISLAND_DISPATCH_ENABLED=true
ASSISTX_RECOVERY_ISLAND_REQUEST_TOKEN=replace-with-agent-request-token
ASSISTX_RECOVERY_ISLAND_AUTO_APPROVE_ACTORS=healer-agent
ASSISTX_RECOVERY_ISLAND_AUTO_APPROVE_ACTIONS=stage,verify,activate
ASSISTX_RECOVERY_ISLAND_AUTO_ACTIVATION_ENABLED=true

# Continuity is the only tier eligible for automatic activation. Durable Neo4j,
# compatibility shadow, worker, and Hermes promotion require separate approval.
ASSISTX_RECOVERY_ISLAND_AUTO_ACTIVATION_DEPLOYMENTS=assistx-continuity

ASSISTX_RECOVERY_ISLAND_RUNBOOK_SIGNING_KEYS_FILE=/run/secrets/recovery-island-runbook-signing-keys.json
ASSISTX_RECOVERY_ISLAND_RUNBOOK_ACTIVE_KEY_ID=runbook-v1
ASSISTX_RECOVERY_ISLAND_ACTIVATION_SIGNING_KEYS_FILE=/run/secrets/recovery-island-activation-signing-keys.json
ASSISTX_RECOVERY_ISLAND_ACTIVATION_ACTIVE_KEY_ID=activation-v1
ASSISTX_RECOVERY_ISLAND_RUNBOOK_TTL_SECONDS=900
ASSISTX_RECOVERY_ISLAND_ACTIVATION_TTL_SECONDS=300
