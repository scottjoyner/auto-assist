ASSISTX_RUNTIME_PROJECTION_PUBLIC_KEY_FILE=<operator-provided-public-key-path>
ASSISTX_EXECUTOR_PRIVATE_KEY_FILE=<operator-provided-executor-private-key-path>
ASSISTX_EXECUTOR_PUBLIC_KEY_FILE=<operator-provided-executor-public-key-path>
