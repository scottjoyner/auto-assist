[Unit]
Description=AssistX private Tailnet services homepage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /home/scott/git/assistx-tailnet-home/server.py
WorkingDirectory=/home/scott/git/assistx-tailnet-home
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=default.target
