# Trace-first execution canary: OFF by default. Never enable unsafe shell.
# Stable, AssistX-provisioned physical identity: do not infer from endpoint URLs.
FLEET_NODE_ID=x1-370
FLEET_TRACE_PROBE_ENABLED=false
# Pre-create mode 0700 and owner-local on EACH physical node. No CIFS plaintext.
FLEET_TRACE_EXECUTION_AUDIT_ROOT=/home/scott/.local/state/assistx/trace-execution
FLEET_UNSAFE_SHELL_TASKS_ENABLED=false
