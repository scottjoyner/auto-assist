# ===== AssistX strict-offline configuration template =====
# Copy to .env, chmod 600, replace placeholders, and keep it untracked.

# ---- Neo4j: canonical durable authority ----
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=assistx

# ---- Strict-offline router-backed inference ----
LLM_BACKEND=openai
OPENAI_BASE_URL=http://host.docker.internal:8088/v1
OPENAI_API_KEY=local-offline-only
LLM_MODEL=local/reconciliation-default
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_S=60
TASK_WALLCLOCK_S=600

# Circuit breaker and node performance tracking
LLM_CB_FAIL_THRESHOLD=3
LLM_CB_OPEN_SECONDS=60
LLM_NODE_SLOW_MULTIPLIER=3.0
LLM_NODE_EMA_ALPHA=0.3
LLM_NODE_REPROBE_AFTER_S=120

# ---- Redis / queue ----
REDIS_URL=redis://assistx-redis:6379/0
WORKER_CONCURRENCY=2
RQ_JOB_TIMEOUT_S=1800

# ---- API / execution ----
CACHE_PATH=/app/.assistx_cache.sqlite
PY_MAX_SECONDS=20
PY_MAX_MEM_MB=256
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me
API_TOKEN=
WS_AUTH_REQUIRED=1
WS_AUTH_TOKEN=
CORS_ALLOW_ORIGINS=*

# ---- Router-only topology ----
ASSISTX_OVERLAY_MODE=router
AUTO_ROUTER_BASE_URL=http://host.docker.internal:8088
AUTO_ASSIGN_BASE_URL=
FLEET_ROUTER_URL=http://host.docker.internal:8088
# Optional router API bearer credential. There is no source-code fallback.
FLEET_ROUTER_BEARER_TOKEN=

# ---- Claim-fenced continuous fleet executor ----
ASSISTX_FLEET_EXECUTOR_ENABLED=true
FLEET_EXECUTOR_AGENT_ID=fleet-executor
FLEET_EXECUTOR_INTERVAL=5
FLEET_EXECUTOR_LLM_CONCURRENCY=16
FLEET_TASK_WALL_TIMEOUT=600
FLEET_TASK_LEASE_SECONDS=720
FLEET_TASK_HEARTBEAT_INTERVAL=15
FLEET_ROUTER_CALL_TIMEOUT=595
FLEET_BACKGROUND_MAX_FRACTION=0.5
FLEET_EXECUTOR_PROJECTION_TTL_SECONDS=60
# "modern" protects agents named in ASSISTX_CLAIM_REQUIRED_AGENTS. Use "all"
# only after every older worker has been migrated to claim-scoped mutations.
ASSISTX_REQUIRE_WORKER_CLAIM_ID=modern
ASSISTX_CLAIM_REQUIRED_AGENTS=fleet-executor
# Temporary migration escape hatch only. Keep empty in the reconciled deployment.
ASSISTX_LEGACY_CLAIMLESS_AGENTS=

# Executor bootstrap/task-token material. Key files must be mode 0600 or stricter.
ASSISTX_EXECUTOR_BOOTSTRAP_TOKEN=replace-with-separate-bootstrap-token
ASSISTX_EXECUTOR_SIGNING_KEY_FILE=/run/secrets/assistx-executor-ed25519.pem
ASSISTX_EXECUTOR_VERIFY_KEY_FILE=/run/secrets/assistx-executor-ed25519-public.pem
ASSISTX_EXECUTOR_KEY_ID=assistx-executor-v1
# Shared only with auto-router's claim-status client. Configure auto-router with:
# AUTO_ROUTER_EXECUTOR_CLAIM_STATUS_URL=http://assistx:8000
# AUTO_ROUTER_ASSISTX_EXECUTOR_SERVICE_TOKEN=<same value>
ASSISTX_EXECUTOR_CLAIM_STATUS_TOKEN=replace-with-separate-router-service-token

# ---- Capacity-aware continuous work supply ----
ASSISTX_WORK_SUPPLY_INTERVAL_SECONDS=15
ASSISTX_BACKGROUND_BACKLOG_PER_FREE_SLOT=4
ASSISTX_MAX_BACKGROUND_BACKLOG=200
ASSISTX_WORK_SUPPLY_STATE_FRESHNESS_SECONDS=60
ASSISTX_KG_HARVESTER_ENABLED=true
KG_HARVEST_INTERVAL=10
KG_READY_THRESHOLD=100
KG_TARGET_BACKLOG=200
KG_MAX_TASKS_PER_CYCLE=10

# ---- Hermes executor ----
HERMES_PROVIDER=assistx-router
HERMES_LM_BASE_URL=http://host.docker.internal:8088/v1
HERMES_MODEL=local/reconciliation-default
HERMES_SMOKE_MODEL=local/reconciliation-default
HERMES_POLL_INTERVAL=15
HERMES_TASK_TIMEOUT=300
HERMES_MAX_TASKS_PER_LOOP=1
HERMES_SELFTASK_ENABLED=false

# ---- Optional legacy Paperclip integration ----
# Leave blank when direct Hermes is the selected execution authority.
PAPERCLIP_API_URL=http://host.docker.internal:3100/api
PAPERCLIP_API_TOKEN=
PAPERCLIP_WORKSPACE_ID=
PAPERCLIP_AGENT_ID=Hermes Agent
PAPERCLIP_WEBHOOK_SECRET=

# ---- Mutation authority defaults ----
# Repository analysis is safe/read-only and can remain continuously enabled once
# ASSISTX_REPOSITORY_ROOTS_JSON is configured. Mutation proposals stay PROPOSED
# and approval-gated; no continuous lane executes arbitrary shell payloads.
ASSISTX_REPO_TASK_GENERATOR_ENABLED=true
ASSISTX_REPO_TASK_AUTO_READY_ANALYSIS=true
ASSISTX_REPO_CREATE_MUTATION_PROPOSALS=true
REPO_TASK_INTERVAL=300
REPO_MAX_TASKS_PER_CYCLE=20
REPO_MAX_FILES_PER_REPO=5
ASSISTX_RECOVERY_EXECUTION_ENABLED=false
FLEET_RECOVERY_RUNBOOKS_ENABLED=false
FLEET_UNSAFE_SHELL_TASKS_ENABLED=false

# ---- Recovery aliases and signing ----
# Values are argv-based typed aliases, never model-authored shell strings.
FLEET_RECOVERY_SERVICE_ALIASES={"inference":{"adapter":"systemd","unit":"lm-studio.service"},"fleet_agent":{"adapter":"systemd","unit":"assistx-fleet-agent.service"}}
FLEET_RECOVERY_COMPOSE_PROJECTS={}
ASSISTX_RUNBOOK_SIGNING_KEYS={"runbook-v1":"replace-with-32-byte-secret"}
ASSISTX_RUNBOOK_ACTIVE_KEY_ID=runbook-v1
ASSISTX_RUNBOOK_TTL_SECONDS=900
FLEET_RUNBOOK_VERIFY_KEYS={"runbook-v1":"replace-with-32-byte-secret"}
ASSISTX_FLEET_NODE_TOKENS={"node-id":"replace-with-node-specific-token"}
FLEET_NODE_TOKEN=replace-with-node-specific-token

# ---- Durable controller / execution reconciliation ----
ASSISTX_RECOVERY_RECONCILE_INTERVAL_SECONDS=60
ASSISTX_CONTROLLER_INSTANCE_ID=
ASSISTX_CONTROLLER_TICK_STALE_MS=900000
ASSISTX_EXECUTION_RECONCILE_INTERVAL_SECONDS=30
ASSISTX_MAX_CHECKPOINT_BYTES=1048576

# ---- Approved runtime projection ----
ASSISTX_RUNTIME_PROJECTION_TTL_SECONDS=60
ASSISTX_RUNTIME_PROJECTION_SIGNING_KEY_FILE=/run/secrets/assistx-runtime-projection-ed25519.pem
ASSISTX_RUNTIME_PROJECTION_SIGNING_KEY_ID=assistx-runtime-projection-v1

# ---- Bounded repository improvement ----
# Values may be strings or objects with a path/root field. Git worktrees are
# supported. Example: {"auto-assist":"/repos/auto-assist","auto-router":{"path":"/repos/auto-router"}}
ASSISTX_REPOSITORY_ROOTS_JSON={}
ASSISTX_IMPROVEMENT_VERIFY_TIMEOUT_SECONDS=120
ASSISTX_IMPROVEMENT_WORKTREE_ROOT=/var/lib/assistx/improvement-worktrees
ASSISTX_IMPROVEMENT_ATTESTATION_KEY_ID=node-id-v1
ASSISTX_IMPROVEMENT_ATTESTATION_SECRET=replace-with-node-specific-secret
ASSISTX_IMPROVEMENT_VERIFY_KEYS={"node-id-v1":"replace-with-node-specific-secret"}

# ---- KV-cache identity ----
ASSISTX_KV_PREFIX_HMAC_SECRET=replace-with-separate-random-secret
FLEET_KV_CACHE_RUNTIME=lmstudio
FLEET_KV_CACHE_CONTROL_URL=

# ---- Local state paths ----
ASSISTX_OUTBOX_DB=~/.assistx_outbox.db
FLEET_STATE_PATH=
FLEET_LOADOUT_PATH=

# ---- Explicitly absent hosted inference credentials ----
# The strict-offline deployment must not populate these in the AssistX, router,
# worker, Hermes, benchmark, or workload environments.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
CLOUDFLARE_API_TOKEN=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# Web retrieval tools are separate from inference routing and remain disabled by
# default during migration. Enable only under an explicit agent/tool policy.
TAVILY_API_KEY=
