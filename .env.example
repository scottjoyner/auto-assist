# ===== AssistX Configuration Template =====
# Copy to .env (same directory) and fill in secrets.
# .env is gitignored; keep secrets there.

# ---- Neo4j ----
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=assistx

# ---- LLM Backend ----
# "openai" (LM Studio / OpenAI API) or "ollama"
LLM_BACKEND=openai
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=not-needed
LLM_TIMEOUT_S=45
TASK_WALLCLOCK_S=600
LLM_MODEL=refinedtoolcallv5-3b
EMBED_MODEL=nomic-embed-text

# ---- Circuit Breaker (LLM fail protection) ----
LLM_CB_FAIL_THRESHOLD=9999
LLM_CB_OPEN_SECONDS=0

# ---- Per-node speed tracking ----
# Nodes > 3x slower than fleet median are skipped.
LLM_NODE_SLOW_MULTIPLIER=3.0
LLM_NODE_EMA_ALPHA=0.3
LLM_NODE_REPROBE_AFTER_S=120

# ---- Redis / Queue ----
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=32

# ---- Ollama (legacy) ----
OLLAMA_HOST=http://host.docker.internal:11434

# ---- API / Execution ----
CACHE_PATH=/app/.assistx_cache.sqlite
PY_MAX_SECONDS=20
PY_MAX_MEM_MB=256

# ---- Dashboard Auth ----
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me

# ---- Web Search ----
TAVILY_API_KEY=

# ---- OpenRouter (optional, for fallback) ----
OPENROUTER_API_KEY=

# ---- Fleet state discovery ----
FLEET_STATE_PATH=/home/scott/git/lms/fleet_state.json

# ---- Overlay / Routing ----
ASSISTX_OVERLAY_MODE=router_plus_assign
AUTO_ROUTER_BASE_URL=http://host.docker.internal:8088
AUTO_ASSIGN_BASE_URL=http://host.docker.internal:8090
HERMES_PROVIDER=assistx-router
HERMES_LM_BASE_URL=http://host.docker.internal:8088/v1
HERMES_MODEL=local/reasoning-large
HERMES_SMOKE_MODEL=refinedtoolcallv5-3b

# ---- Paperclip ----
PAPERCLIP_API_URL=http://host.docker.internal:3100/api
PAPERCLIP_API_TOKEN=
PAPERCLIP_WORKSPACE_ID=

# ---- Optional ----
ASSISTX_USER=admin
ASSISTX_PASS=change-me
CORS_ALLOW_ORIGINS=*
# Recursive improvement is proposal-only and disabled unless explicitly enabled.
ASSISTX_REPO_TASK_GENERATOR_ENABLED=false
ASSISTX_REPO_TASK_AUTO_READY=false
ASSISTX_RECOVERY_EXECUTION_ENABLED=false
# Node agents must explicitly opt in to typed recovery runbooks.
FLEET_RECOVERY_RUNBOOKS_ENABLED=false
# JSON alias maps; values are passed as argv, never through a shell.
FLEET_RECOVERY_SERVICE_ALIASES={"inference":{"adapter":"systemd","unit":"lm-studio.service"},"fleet_agent":{"adapter":"systemd","unit":"assistx-fleet-agent.service"}}
FLEET_RECOVERY_COMPOSE_PROJECTS={}
# Rotate by adding a new key and changing the active key ID.
ASSISTX_RUNBOOK_SIGNING_KEYS={"runbook-v1":"replace-with-32-byte-secret"}
ASSISTX_RUNBOOK_ACTIVE_KEY_ID=runbook-v1
ASSISTX_RUNBOOK_TTL_SECONDS=900
ASSISTX_RECOVERY_RECONCILE_INTERVAL_SECONDS=60
# Stable per-process identity is optional; the default includes hostname, PID,
# and a random boot suffix. Set this when the deployment platform provides a
# unique replica identity.
ASSISTX_CONTROLLER_INSTANCE_ID=
# A RUNNING checkpoint older than this may be reclaimed by a newer fenced leader.
ASSISTX_CONTROLLER_TICK_STALE_MS=900000
ASSISTX_EXECUTION_RECONCILE_INTERVAL_SECONDS=30
ASSISTX_MAX_CHECKPOINT_BYTES=1048576
ASSISTX_REPOSITORY_ROOTS_JSON={}
ASSISTX_IMPROVEMENT_VERIFY_TIMEOUT_SECONDS=120
ASSISTX_IMPROVEMENT_WORKTREE_ROOT=/var/lib/assistx/improvement-worktrees
ASSISTX_IMPROVEMENT_ATTESTATION_KEY_ID=node-id-v1
ASSISTX_IMPROVEMENT_ATTESTATION_SECRET=replace-with-node-specific-secret
ASSISTX_IMPROVEMENT_VERIFY_KEYS={"node-id-v1":"replace-with-node-specific-secret"}
# Keyed digest for tokenized stable prefixes. Never store raw prompts in Neo4j.
ASSISTX_KV_PREFIX_HMAC_SECRET=replace-with-separate-random-secret
# Node runtime identity and optional authenticated local adapter. LM Studio and
# vLLM can use affinity without an adapter; llama.cpp slot persistence and
# SGLang HiCache restoration require a runtime-specific control service.
FLEET_KV_CACHE_RUNTIME=lmstudio
FLEET_KV_CACHE_CONTROL_URL=
ASSISTX_OUTBOX_DB=~/.assistx_outbox.db
FLEET_RUNBOOK_VERIFY_KEYS={"runbook-v1":"replace-with-32-byte-secret"}
# Control-plane registry and node-local token must agree for recovery traffic.
ASSISTX_FLEET_NODE_TOKENS={"node-id":"replace-with-node-specific-token"}
FLEET_NODE_TOKEN=replace-with-node-specific-token
# Legacy payload.command/cmd/yolo_command execution is unsafe and opt-in only.
FLEET_UNSAFE_SHELL_TASKS_ENABLED=false
