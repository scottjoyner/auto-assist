# Example for one already-running benchmark-only llama.cpp policy.
# Copy these values into the operator environment; do not commit secrets.

# Replay endpoint used by the experiment runner.
ASSISTX_BENCH_R9700_Q4_DFLASH_URL=http://127.0.0.1:8080

# Read-only telemetry sidecar started beside that exact runtime.
ASSISTX_BENCH_R9700_Q4_DFLASH_TELEMETRY_URL=http://127.0.0.1:9188

# Expected identity. These are checked by the replay runner before inference.
ASSISTX_BENCH_R9700_Q4_DFLASH_RUNTIME_REVISION=llama.cpp@REPLACE_WITH_EXACT_SHA
ASSISTX_BENCH_R9700_Q4_DFLASH_LAUNCH_SHA256=REPLACE_WITH_64_CHAR_CMDLINE_SHA256

# Sidecar immutable identity.
ASSISTX_TELEMETRY_NODE_ID=r9700
ASSISTX_TELEMETRY_MODEL_HANDLE=qwen3.8-27b-q4
ASSISTX_TELEMETRY_BACKEND=rocm
ASSISTX_TELEMETRY_QUANTIZATION=q4
ASSISTX_TELEMETRY_SPECULATION=dflash
ASSISTX_TELEMETRY_RUNTIME_REVISION=llama.cpp@REPLACE_WITH_EXACT_SHA

# PID of the exact already-running llama-server process. The sidecar hashes
# /proc/<pid>/cmdline and observes its process start time. It never signals it.
ASSISTX_TELEMETRY_RUNTIME_PID=REPLACE_WITH_PID

# llama-server must already have --metrics enabled.
ASSISTX_TELEMETRY_LLAMA_METRICS_URL=http://127.0.0.1:8080/metrics

# Optional in llama.cpp router mode.
# ASSISTX_TELEMETRY_LLAMA_METRICS_MODEL=qwen3.8-27b-q4

# Optional Linux AMD GPU sysfs device for VRAM/utilization/power gauges.
# Example only; select the correct DRM device for the runtime host.
ASSISTX_TELEMETRY_DRM_DEVICE_SYSFS=/sys/class/drm/card1/device

# Sidecar listens on loopback by default and exposes GET only.
ASSISTX_TELEMETRY_BIND=127.0.0.1
ASSISTX_TELEMETRY_PORT=9188
